{
	"name": "ccc-review",
	"version": "1.0.0",
	"private": true,
	"license": "MIT",
	"homepage": "https://github.com/hlavacm/ccc-review",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hlavacm/ccc-review.git"
	},
	"description": "CCC Review — Claude Code ↔ Codex Review",
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"test": "node --import ./test/setup.ts --test \"test/**/*.test.ts\"",
		"test:all": "pnpm test",
		"test:unit": "node --import ./test/setup.ts --test \"test/unit/**/*.test.ts\"",
		"test:integration": "node --import ./test/setup.ts --test \"test/integration/**/*.test.ts\"",
		"test:coverage": "node --import ./test/setup.ts --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" \"test/**/*.test.ts\"",
		"test:smoke": "CCC_REVIEW_SMOKE=1 node --import ./test/setup.ts --test --test-timeout=1500000 \"test/smoke/**/*.smoke.ts\"",
		"test:smoke:install": "node --import ./test/setup.ts --test --test-timeout=600000 test/smoke/install.smoke.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write .",
		"build": "tsc -p tsconfig.build.json",
		"check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/node": "^26.6.2",
		"typescript": "^7.0.2"
	}
}
